*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}


body{

    background:linear-gradient(
        135deg,
        #ffcc00,
        #ff6600,
        #8a2be2,
        #0066ff
    );

    min-height:100vh;
    color:white;

}



/* Barre du haut */

header{

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:20px;

    background:rgba(0,0,0,0.25);

    backdrop-filter:blur(10px);

}


header h1{

    font-size:30px;

    color:white;

}



button{

    border:none;

    padding:12px 25px;

    border-radius:30px;

    background:white;

    color:#8a2be2;

    font-weight:bold;

    cursor:pointer;

}





/* Page accueil */

.hero{

    text-align:center;

    padding:50px 20px;

}


.hero h2{

    font-size:38px;

    margin-bottom:15px;

}


.hero p{

    font-size:20px;

}


.start{

    margin-top:25px;

    background:#ffd700;

    color:#111;

}



/* Titres */

.title{

    margin:20px;

}



/* Stories */

.stories{

    display:flex;

    gap:20px;

    overflow-x:auto;

    padding:20px;

}


.stories div{

    min-width:90px;

    height:90px;

    border-radius:50%;

    background:linear-gradient(
        45deg,
        #ff0055,
        #ffcc00
    );

    display:flex;

    justify-content:center;

    align-items:center;

    text-align:center;

    font-weight:bold;

    border:4px solid white;

}





/* Reels */

.reels{

    display:flex;

    gap:20px;

    padding:20px;

    overflow-x:auto;

}



.card{

    min-width:220px;

    height:330px;

    background:

    linear-gradient(
        180deg,
        #222,
        #000
    );


    border-radius:25px;

    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:center;


    font-size:45px;

    box-shadow:

    0 10px 30px rgba(0,0,0,.3);

}


.card p{

    font-size:16px;

    margin:15px;

}




/* Menu bas */

footer{

    position:fixed;

    bottom:0;

    width:100%;

    padding:18px;

    text-align:center;


    background:rgba(0,0,0,.6);

    font-size:16px;

}
