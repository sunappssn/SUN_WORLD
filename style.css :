*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial;
}


body{

background:#000;
overflow:hidden;

}



.top{

position:fixed;
top:0;
width:100%;
padding:20px;
text-align:center;

color:white;
font-size:25px;
font-weight:bold;

z-index:10;

background:linear-gradient(
90deg,
#001f3f,
#ffd700
);

}



.tiktok{

height:100vh;
overflow-y:scroll;
scroll-snap-type:y mandatory;

}



.video-card{

height:100vh;
position:relative;

scroll-snap-align:start;

}



.video-card video{

width:100%;
height:100%;

object-fit:cover;

}



.info{

position:absolute;

bottom:120px;
left:20px;

color:white;

max-width:70%;

}



.info h2{

font-size:24px;

}



.info p{

font-size:18px;
margin-top:10px;

}



.actions{

position:absolute;

right:20px;
bottom:150px;

display:flex;
flex-direction:column;
gap:20px;

}



.actions button{

background:rgba(255,255,255,0.2);

border:none;

color:white;

font-size:18px;

border-radius:50%;

width:70px;
height:70px;

}



.bottom{

position:fixed;

bottom:0;

width:100%;

display:flex;

justify-content:space-around;

padding:15px;

background:#111;

color:white;

font-size:30px;

}
